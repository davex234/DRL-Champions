  "extraUi": [
    "/admin/cards/new → /admin/cartas/nueva",
    "/admin/cards/[id] → /admin/cartas/[id]",
    "/admin/events/new",
    "/admin/events/[id]",
    "/admin/users/[id]",
    "/admin/players/[id]",
    "/admin/teams/[id]",
    "/admin/packs/[id]",
    "/admin/roster (editor local heredado)"
  ],
  "api": [
    {
      "path": "/api/admin/dashboard",
      "methods": {
        "GET": "admin_read"
      }
    },
    {
      "path": "/api/admin/search",
      "methods": {
        "GET": "admin_read"
      }
    },
    {
      "path": "/api/admin/users",
      "methods": {
        "GET": "admin_read",
        "POST": "admin_write (adjust_credits · grant)"
      }
    },
    {
      "path": "/api/admin/moderation",
      "methods": {
        "GET": "admin_read",
        "POST": "admin_write (sanction · revoke)"
      }
    },
    {
      "path": "/api/admin/events",
      "methods": {
        "GET": "admin_read",
        "POST": "admin_write (preview · create · update · cancel · publish)"
      }
    },
    {
      "path": "/api/admin/audit",
      "methods": {
        "GET": "admin_read (sin escritura HTTP)"
      }
    },
    {
      "path": "/api/admin/system",
      "methods": {
        "GET": "admin_read"
      }
    },
    {
      "path": "/api/admin/catalog",
      "methods": {
        "GET": "admin_read (players · player · teams · team · seasons · competitive · rewards)",
        "POST": "admin_read (import_dry_run: solo valida)"
      }
    },
    {
      "path": "/api/admin/packs",
      "methods": {
        "GET": "admin_read (lista · ficha · economy)",
        "POST": "admin_write (simulate: solo lectura, CPU)"
      }
    },
    {
      "path": "/api/admin/cards",
      "methods": {
        "POST": "existente (verifyAdmin): list · facets · create · updateDraft · publish · lifecycle · artwork…"
      }
    },
    {
      "path": "/api/admin/pools",
      "methods": {
        "POST": "existente (verifyAdmin)"
      }
    },
    {
      "path": "/api/admin/{assets,operations,releases,tournaments,session}",
      "methods": {
        "*": "existentes (verifyAdmin)"
      }
    }
  ],
  "palette": [
    {
      "id": "new-card",
      "label": "Crear carta (borrador)",
      "href": "/admin/cartas/nueva"
    },
    {
      "id": "new-event",
      "label": "Crear evento (borrador)",
      "href": "/admin/events/new"
    },
    {
      "id": "find-user",
      "label": "Buscar usuario",
      "href": "/admin/users"
    },
    {
      "id": "health",
      "label": "Ver salud del sistema",
      "href": "/admin/system"
    },
    {
      "id": "audit",
      "label": "Abrir registro de auditoría",
      "href": "/admin/audit"
    }
  ]
}