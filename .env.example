# DRL Champions — variables de entorno
#
# Si NO defines estas variables, el juego funciona en MODO LOCAL (localStorage),
# exactamente como hasta ahora. Al definirlas, se activa el modo online
# (cuentas, sincronización en la nube, ranking y mercado entre jugadores).

# Supabase (Proyecto → Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Sincronización competitiva (SOLO SERVIDOR — nunca con prefijo NEXT_PUBLIC_).
# Clave service_role de Supabase: salta RLS para escribir el catálogo deportivo.
SUPABASE_SERVICE_ROLE_KEY=
# Secreto que protege los endpoints POST /api/esports/sync, /api/market/sync-reference
# y /api/esports/predict (cron/edge).
SYNC_SECRET=

# IA de análisis competitivo (SOLO SERVIDOR). Sin ANTHROPIC_API_KEY, el motor de
# predicción usa su proveedor heurístico local (sin coste). Con clave, usa Claude
# para el análisis cualitativo.
ANTHROPIC_API_KEY=
# Modelo por defecto (partidos destacados) y modelo económico (lotes).
ANTHROPIC_MODEL=claude-opus-4-8
ANTHROPIC_MODEL_BULK=claude-haiku-4-5

# Panel de administración en producción (en desarrollo está siempre activo)
NEXT_PUBLIC_ADMIN=

# DRL Data Engine (opcional). Sin estas variables usa la fuente mock y solo
# registra incidencias en la app (sin Telegram).
# Endpoint JSON que mapea VLR.gg a la interfaz DataSource (proxy propio):
NEXT_PUBLIC_VLR_API=
# Webhook propio que reenvía a Telegram (NUNCA pongas aquí el token del bot):
NEXT_PUBLIC_TELEGRAM_WEBHOOK=
