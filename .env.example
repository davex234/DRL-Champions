# DRL Champions — variables de entorno
#
# Si NO defines estas variables, el juego funciona en MODO LOCAL (localStorage),
# exactamente como hasta ahora. Al definirlas, se activa el modo online
# (cuentas, sincronización en la nube, ranking y mercado entre jugadores).

# Supabase (Proyecto → Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Sincronización competitiva (SOLO SERVIDOR — nunca con prefijo NEXT_PUBLIC_).
# Clave service_role de Supabase: salta RLS para escribir el catálogo deportivo.
SUPABASE_SERVICE_ROLE_KEY=
# Secreto que protege los endpoints POST /api/esports/sync, /api/market/sync-reference
# y /api/esports/predict (cron/edge).
SYNC_SECRET=

# IA de análisis competitivo (SOLO SERVIDOR). Sin ANTHROPIC_API_KEY, el motor de
# predicción usa su proveedor heurístico local (sin coste). Con clave, usa Claude
# para el análisis cualitativo.
ANTHROPIC_API_KEY=
# Modelo por defecto (partidos destacados) y modelo económico (lotes).
ANTHROPIC_MODEL=claude-opus-4-8
ANTHROPIC_MODEL_BULK=claude-haiku-4-5

# Panel de administración en producción (en desarrollo está siempre activo)
NEXT_PUBLIC_ADMIN=

# DRL Data Engine (opcional). Sin estas variables usa la fuente mock y solo
# registra incidencias en la app (sin Telegram).
# Endpoint JSON que mapea VLR.gg a la interfaz DataSource (proxy propio):
NEXT_PUBLIC_VLR_API=
# Webhook propio que reenvía a Telegram (NUNCA pongas aquí el token del bot):
NEXT_PUBLIC_TELEGRAM_WEBHOOK=

# ── Fase 24.6 · ESPORTS AUTO-SYNC (VLR → NEXUS sin intervención humana) ──
# Kill switch. Sin `true` explícito el scheduler NO ejecuta nada (el sync manual sigue funcionando).
ESPORTS_AUTO_SYNC_ENABLED=false
# Secreto del trigger interno POST /api/internal/esports/sync (Authorization: Bearer …).
# Por defecto reutiliza SYNC_SECRET; mínimo 16 caracteres. Solo servidor, nunca NEXT_PUBLIC.
# ESPORTS_SYNC_SECRET=
# Frecuencias (segundos) por clase de evento. Defaults: live 120 · active 600 · upcoming 1800 · future 21600 · recent 3600.
# ESPORTS_AUTO_SYNC_INTERVAL_LIVE_S=120
# ESPORTS_AUTO_SYNC_INTERVAL_ACTIVE_S=600
# ESPORTS_AUTO_SYNC_INTERVAL_UPCOMING_S=1800
# ESPORTS_AUTO_SYNC_INTERVAL_FUTURE_S=21600
# ESPORTS_AUTO_SYNC_INTERVAL_RECENT_S=3600
# Timeout por petición a la fuente (s), eventos en paralelo (1 = secuencial) y lease del lock (s).
# ESPORTS_AUTO_SYNC_TIMEOUT_S=15
# ESPORTS_AUTO_SYNC_MAX_CONCURRENCY=1
# ESPORTS_AUTO_SYNC_LOCK_TTL_S=600

# ═══════════════════════════════════════════════════════════════════════════════════════════════════════════
# F70 · PLANTILLA CANÓNICA DE RELEASE (única: no hay otra .env.* de plantilla). Solo marcadores, NUNCA secretos.
# Dos destinos distintos:
#   [APP]  → .env.local / entorno del proceso Next.js (PC hoy, :3005 ligado a 127.0.0.1).
#   [VPS]  → entorno de GoTrue en el stack supabase-drlcards del VPS (NO los lee la app; aquí solo como referencia).
#   [OPS]  → fichero offsite.env del VPS (DRL_OFFSITE_CONFIG), lo lee scripts/ops/backup-offsite.sh.
# ═══════════════════════════════════════════════════════════════════════════════════════════════════════════

# ── [APP] Modo público y dominio ──
# Interruptor de release pública. Ausente/0 = comportamiento actual (beta cerrada / local), sin cambios.
# =1 → el arranque (NODE_ENV=production) ABORTA si NEXT_PUBLIC_SITE_URL o NEXT_PUBLIC_SUPABASE_URL no son https
# públicos, o si NEXUS_QA_HARNESS/NEXUS_SANDBOX_CREDITS=1; y `npm run production:check -- --app --vps` FALLA con
# SMTP local (inbucket/mailpit/localhost), SITE_URL local, autoconfirmación, allow-list local u offsite no verificado.
# DRL_PUBLIC_RELEASE=0
# valorosters.com (beta privada) · el navegador habla con Supabase por SU PROPIO origen: Next reenvía /auth/v1, /rest/v1 y
# /storage/v1 a SUPABASE_INTERNAL_URL (el túnel SSH local). NEXT_PUBLIC_SUPABASE_URL = el dominio público (URL que se
# generan para el navegador); el tráfico del SERVIDOR va al interno (src/lib/supabase/serverUrl.ts). Sin estas dos, todo
# queda como antes.
# NEXT_PUBLIC_SUPABASE_SAME_ORIGIN=1
# SUPABASE_INTERNAL_URL=http://127.0.0.1:54521
# Origen canónico (https, sin barra final). Debe coincidir con GOTRUE_SITE_URL.
# NEXT_PUBLIC_SITE_URL=https://<dominio-canonico>
# En la release pública, NEXT_PUBLIC_SUPABASE_URL (arriba) también debe ser https pública (API de Supabase/Kong),
# no 127.0.0.1:54521: el navegador del jugador no pasa por el túnel SSH.
# Indexación (se decide en BUILD): 1 = robots permite el sitio. production:check lo trata también como público.
# NEXUS_PUBLIC_INDEXING=0

# ── [APP] Seguridad (en producción/público deben estar ausentes o a 0) ──
# NEXUS_QA_HARNESS=0        # 1 expone /design-system
# NEXUS_SANDBOX_CREDITS=0   # el servidor lo ignora en producción
# Interruptores de producto: NO son variables de entorno, son constantes de código revisadas por production:check:
#   GLOBAL_MARKET_ENABLED=false (src/config/features.ts) · PAYMENTS_ENABLED=false (src/config/monetization.ts)

# ── [VPS] Auth / GoTrue (stack supabase-drlcards; hoy: SITE_URL local, Inbucket, autoconfirmación ON) ──
# GOTRUE_SITE_URL=https://<dominio-canonico>
# GOTRUE_URI_ALLOW_LIST=https://<dominio-canonico>/cuenta,https://<dominio-canonico>/**
# API_EXTERNAL_URL=https://<host-api-supabase>
# GOTRUE_MAILER_AUTOCONFIRM=false
# GOTRUE_EXTERNAL_EMAIL_ENABLED=true
# ── [VPS] SMTP real de GoTrue (proveedor pendiente de elegir por el usuario) ──
# GOTRUE_SMTP_HOST=<smtp.proveedor>
# GOTRUE_SMTP_PORT=587
# GOTRUE_SMTP_USER=<usuario>
# GOTRUE_SMTP_PASS=<secreto-solo-en-el-VPS>
# GOTRUE_SMTP_ADMIN_EMAIL=<no-reply@dominio-canonico>
# GOTRUE_SMTP_SENDER_NAME=DRL Champions

# ── [OPS] Copia fuera del VPS (offsite.env, 600; ver scripts/ops/backup-offsite.sh check-config) ──
# DRL_OFFSITE_ENABLED=0
# DRL_OFFSITE_REMOTE=<remoto>:<bucket>/drlcards
# DRL_OFFSITE_RCLONE_CONFIG=/ruta/rclone.conf
# DRL_OFFSITE_RECIPIENT_CRT=/ruta/backup-recipient.crt
# DRL_OFFSITE_RETENTION=provider
# DRL_OFFSITE_SSH_KNOWN_HOSTS=   # solo con sftp
# Opcionales: DRL_OFFSITE_RCLONE_IMAGE DRL_OFFSITE_KEEP_DAILY/WEEKLY/MONTHLY DRL_OFFSITE_CONTIMEOUT DRL_OFFSITE_IOTIMEOUT DRL_OFFSITE_BWLIMIT

# ── [QA] Solo herramientas de QA locales (scripts/lib/qaCredentials.ts: qaPassword("QA_<CUENTA>_PASSWORD")).
# Opcionales; NUNCA en el entorno de producción ni en el VPS. Ver docs/operations/drlcards-qa-accounts.md.
# QA_<CUENTA>_PASSWORD=
